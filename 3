import random

# Генерируем вложенный список (3 строки по 4 элемента с отрицательными, нулями и положительными)
matrix = [[random.randint(-10, 10) for _ in range(4)] for _ in range(3)]
print(f"Исходный список: {matrix}")

# Создаем новый вложенный список только с положительными элементами
filtered_matrix = []

for i in range(len(matrix)):
    new_row = []
    for j in range(len(matrix[i])):
        if matrix[i][j] > 0:
            new_row.append(matrix[i][j])
    filtered_matrix.append(new_row)

print(f"Отфильтрованный список: {filtered_matrix}")
