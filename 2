import random

# Генерируем вложенный список (3 строки по 4 элемента)
matrix = [[random.randint(1, 10) for _ in range(4)] for _ in range(3)]
print(f"Исходный список: {matrix}")

# Список для хранения сумм строк
row_sums = []
total_sum = 0

# 1. Вычисляем сумму каждой строки
for i in range(len(matrix)):
    current_sum = 0
    for j in range(len(matrix[i])):
        current_sum += matrix[i][j]
    row_sums.append(current_sum)
    total_sum += current_sum
    print(f"Сумма строки {i}: {current_sum}")

# 2. Общая сумма
print(f"Общая сумма всех элементов: {total_sum}")

# 3. Строка с максимальной суммой
max_sum = max(row_sums)
max_index = row_sums.index(max_sum)
print(f"Строка с максимальной суммой: {max_index} (сумма = {max_sum})")
